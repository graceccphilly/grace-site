"Grace Community Church official launch service", "startDate": "2026-11-01T15:00:00-05:00", "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode", "location": {"@type": "Place", "name": "Meredith Elementary School (cafeteria)", "address": {"@type": "PostalAddress", "streetAddress": "725 S 5th St", "addressLocality": "Philadelphia", "addressRegion": "PA", "postalCode": "19147", "addressCountry": "US"}}}]}</script>
