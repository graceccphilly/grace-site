<main id="main">

<section class="hero" id="top" aria-roledescription="carousel" aria-label="Highlights">
  <div class="hero-stage">
  <div class="hero-bgs" aria-hidden="true" id="hero-bgs"></div>
  <div class="wrap hero-inner" id="hero-carousel">
    <div class="slides" id="hero-slides" aria-live="off">
      <div class="slide is-active" role="group" aria-roledescription="slide" aria-label="Welcome" data-slide="welcome" data-name="Welcome">
        <div class="hero-copy">
          <h1 class="hero-h"><span class="h1-name">Grace Community Church · Philadelphia, PA</span> <span class="h1-motto"><span>We love God.</span><span>We love people.</span><span class="hl">We do good.</span></span></h1>
          <p class="lede">Worship with us in person and online every Sunday at 12:00 PM, and study the Bible with us on Wednesday nights.<span data-until="2026-11-01"> Our official launch service is Sunday, November 1 at 3:00 PM.</span></p>
          <div class="actions">
            <a class="btn" href="#visit">Plan your visit</a>
            <a class="btn quiet" href="https://www.facebook.com/gracecommunityphilly/" target="_blank" rel="noopener">Watch online<span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
        <span class="emblem hero-emblem" aria-hidden="true"></span>
      </div>
      <div class="slide" role="group" aria-roledescription="slide" aria-label="Launch service" data-slide="launch" data-name="Launch service" data-until="2026-11-01">
        <div class="hero-copy">
          <h2 class="hero-h"><span class="h1-name">Save the date</span> <span class="h1-motto"><span>Official</span><span>launch</span><span class="hl">service.</span></span></h2>
          <p class="lede">Join us on Sunday, November 1, 2026 at 3:00 PM for the official launch of Grace Community Church at Meredith Elementary School (cafeteria), 725 S 5th St, Philadelphia.</p>
          <div class="actions">
            <a class="btn" href="#upcoming">See upcoming services</a>
          </div>
        </div>
        <div class="ticket">
          <span class="tag">Save the date</span>
          <p class="when">Nov 1</p>
          <p class="time">Sunday · 3:00 PM</p>
          <p class="what">Official launch service</p>
          <p class="where">Meredith Elementary School (cafeteria), 725 S 5th St</p>
        </div>
      </div>
      <div class="slide" role="group" aria-roledescription="slide" aria-label="Bible study" data-slide="bible" data-name="Bible study" data-until="2026-10-31">
        <div class="hero-copy">
          <h2 class="hero-h"><span class="h1-name">Bible study · The Apostles’ Creed</span> <span class="h1-motto"><span>Bible study:</span><span class="hl">Faith 101.</span></span></h2>
          <p class="lede">Line by line, we break down the core tenets of the Christian faith. Every Wednesday in October on Zoom and Facebook Live.</p>
          <p class="zoom-id"><span>Meeting ID: <b>880 2297 9559</b></span> <span>Passcode: <b>19061906</b></span></p>
          <div class="actions">
            <a class="btn" href="https://us06web.zoom.us/j/88022979559?pwd=G7K6SVRMGFtdgMQQwhhbsYrDfUQAPT.1" target="_blank" rel="noopener">Join on Zoom<span class="sr-only"> (opens in a new tab)</span></a>
            <a class="btn quiet" href="/biblestudy/thisweek/lesson.pdf">Download this week’s lesson</a>
          </div>
        </div>
        <div class="ticket">
          <span class="tag">Wednesdays in October</span>
          <p class="when">7:00 PM</p>
          <p class="time">Zoom + Facebook Live</p>
          <p class="what">Faith 101</p>
          <p class="where">The Apostles’ Creed, line by line.</p>
        </div>
      </div>
      <div class="slide" role="group" aria-roledescription="slide" aria-label="Bible study" data-slide="bibleNov" data-name="Bible study" data-from="2026-11-01" data-until="2026-11-30">
        <div class="hero-copy">
          <h2 class="hero-h"><span class="h1-name">Bible study · November</span> <span class="h1-motto"><span>Methodism: 101</span><span>What do we</span><span class="hl">believe</span></span></h2>
          <p class="lede">Our November Bible study. Every Wednesday in November at 7:00 PM on Zoom and Facebook Live.</p>
          <p class="zoom-id"><span>Meeting ID: <b>880 2297 9559</b></span> <span>Passcode: <b>19061906</b></span></p>
          <div class="actions">
            <a class="btn" href="https://us06web.zoom.us/j/88022979559?pwd=G7K6SVRMGFtdgMQQwhhbsYrDfUQAPT.1" target="_blank" rel="noopener">Join on Zoom<span class="sr-only"> (opens in a new tab)</span></a>
            <a class="btn quiet" href="/biblestudy/thisweek/lesson.pdf">Download this week’s lesson</a>
          </div>
        </div>
        <div class="ticket">
          <span class="tag">Wednesdays in November</span>
