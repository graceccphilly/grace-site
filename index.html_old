  meetingPlaces: [
    { until: "2026-10-18", name: "Mother Bethel AME Church", address: "419 S 6th St, Philadelphia, PA 19147", time: "12:00 PM", when: "Sundays, Oct 11 & 18 · 12:00 PM", embed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3058.914331494515!2d-75.15433712403855!3d39.94330588431766!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c6c89dce8724e3%3A0xe65f30c2230e5a33!2sMother%20Bethel%20African%20Methodist%20Episcopal%20Church!5e0!3m2!1sen!2sus!4v1791393170178!5m2!1sen!2sus" },
    { until: "2026-10-25", name: "Mt. Zion United Methodist Church", address: "1530 N 11th St, Philadelphia, PA 19122", time: "11:00 AM", when: "Sunday, Oct 25 · 11:00 AM", embed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3057.449277796189!2d-75.15594892403706!3d39.976064082342106!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c6c8750d33f387%3A0x758ef05e2a5f6aa5!2sMt.%20Zion%20United%20Methodist%20Church!5e0!3m2!1sen!2sus!4v1791393211512!5m2!1sen!2sus" },
    { until: "2026-11-01", name: "Meredith Elementary School (cafeteria)", address: "725 S 5th St, Philadelphia, PA 19147", time: "3:00 PM", when: "Sunday, Nov 1 · 3:00 PM · Official launch service", embed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3059.082793589414!2d-75.15323662403868!3d39.939537684544746!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c6c89f0419216f%3A0x3e01c45119eaad6f!2sMeredith%20Elementary%20School!5e0!3m2!1sen!2sus!4v1791393246819!5m2!1sen!2sus" },
    { name: "Meredith Elementary School (cafeteria)", address: "725 S 5th St, Philadelphia, PA 19147", time: "12:00 PM", when: "Every Sunday", embed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3059.082793589414!2d-75.15323662403868!3d39.939537684544746!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c6c89f0419216f%3A0x3e01c45119eaad6f!2sMeredith%20Elementary%20School!5e0!3m2!1sen!2sus!4v1791393246819!5m2!1sen!2sus" }
  ],

  // Whole-page background photo. It stays fixed while the page scrolls, under a cream layer at 85%.
  // The image files sit in the "images" folder next to this page. Use "" for plain cream.
  pageImage:      "images/background.jpg",
  pageImageSmall: "images/background-phone.jpg",   // taller crop used on phones; "" to use the main photo everywhere

  // Optional photo behind each hero slide (1920x1080), e.g. welcome: "images/hero-welcome.jpg".
  heroImages:  { welcome: "", launch: "", bible: "", bibleNov: "", food: "" },
  // Colour laid over each slide photo at 85% opacity: "light" (cream, dark text) or "dark" (black, light text).
  heroTone:    "light"
};
var EMBEDS = true; // true on the hosted site; the Claude preview cannot show YouTube or Google Maps frames

(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

  /* Dated content looks after itself. data-until="YYYY-MM-DD" removes something the day after that date;
     data-from="YYYY-MM-DD" keeps it back until that date. Used on hero slides, flyers, service cards,
     the food drive and dated lines of text. */
  var today = new Date(); today.setHours(0, 0, 0, 0);
  function day(v) { var d = v.split("-"); return new Date(+d[0], +d[1] - 1, +d[2]); }
  $$("[data-until], [data-from]").forEach(function (el) {
    var until = el.getAttribute("data-until"), from = el.getAttribute("data-from");
    if ((until && day(until) < today) || (from && day(from) > today)) el.parentNode.removeChild(el);
  });
  if (!$("#svc-cards .svc")) { $("#svc-cards").hidden = true; $("#svc-empty").hidden = false; }
  if (!$("#serve .min")) $("#serve-empty").hidden = false;
  var tileCount = $$("#gallery-grid .tile").length;
  if (!tileCount) $("#gallery").hidden = true; else if (tileCount === 1) $("#gallery-grid").classList.add("single");
  $("#year").textContent = Math.max(2026, today.getFullYear());

  /* Hero carousel: rotates every 7 seconds. It waits while a mouse is over it or keyboard focus is inside it,
     and stops for good when someone uses a control, swipes, or presses pause. It starts stopped for reduced-motion. */
  var slides = $$("#hero-slides .slide"), pauseBtn = $("#hs-pause"), pauseIcon = $("#hs-pause-icon"),
      region = $("#hero-carousel"), live = $("#hero-slides"), cur = 0, timer = null, hovered = false, focused = false,
      playing = !(window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches);
  if (SITE.pageImage) {
    document.documentElement.style.setProperty("--page-image", 'url("' + SITE.pageImage + '")');
    if (SITE.pageImageSmall) document.documentElement.style.setProperty("--page-image-small", 'url("' + SITE.pageImageSmall + '")');
    document.documentElement.classList.add("has-page-bg");
  }
  /* one background layer and one marker per slide that is still current */
  var imgs = SITE.heroImages || {}, anyImg = false;
  var bgs = slides.map(function (sl, n) {
    var bg = document.createElement("div"); bg.className = "hero-bg" + (n ? "" : " is-active");
    var src = imgs[sl.getAttribute("data-slide")];
    if (src) { bg.style.backgroundImage = 'url("' + src + '")'; bg.classList.add("has-img"); anyImg = true; }
    $("#hero-bgs").appendChild(bg); return bg;
  });
  if (SITE.heroTone === "dark" && anyImg) $(".hero").classList.add("dark");
  var dots = slides.map(function (sl, n) {
    var label = (n + 1) + " of " + slides.length + ": " + sl.getAttribute("data-name");
    sl.setAttribute("aria-label", label);
    var d = document.createElement("button"); d.type = "button"; d.setAttribute("aria-label", "Slide " + label);
    d.addEventListener("click", function () { manual(n); });
    $("#hs-dots").appendChild(d); return d;
  });
  if (slides.length < 2) { $(".hero-ctl").hidden = true; playing = false; }
  function go(i) {
    cur = (i + slides.length) % slides.length;
    slides.forEach(function (sl, n) { sl.classList.toggle("is-active", n === cur); });
    bgs.forEach(function (bg, n) { bg.classList.toggle("is-active", n === cur); });
    dots.forEach(function (d, n) { if (n === cur) d.setAttribute("aria-current", "true"); else d.removeAttribute("aria-current"); });
  }
  function sync() {
    clearInterval(timer); timer = null;
    if (playing && !hovered && !focused && !document.hidden) timer = setInterval(function () { go(cur + 1); }, 7000);
    live.setAttribute("aria-live", playing ? "off" : "polite");
    pauseBtn.setAttribute("aria-label", playing ? "Pause slide rotation" : "Start slide rotation");
    pauseIcon.setAttribute("d", playing ? "M9 5v14M15 5v14" : "M8 5v14l11-7z");
  }
  function manual(i) { playing = false; go(i); sync(); }
  $("#hs-prev").addEventListener("click", function () { manual(cur - 1); });
  $("#hs-next").addEventListener("click", function () { manual(cur + 1); });
  pauseBtn.addEventListener("click", function () { playing = !playing; sync(); });
  /* hover only counts for a real mouse, so a tap on a phone no longer freezes the slider */
  if (window.PointerEvent) {
    region.addEventListener("pointerenter", function (ev) { if (ev.pointerType === "mouse") { hovered = true; sync(); } });
    region.addEventListener("pointerleave", function (ev) { if (ev.pointerType === "mouse") { hovered = false; sync(); } });
  }
  region.addEventListener("focusin", function () { focused = true; sync(); });
  region.addEventListener("focusout", function (ev) { if (!region.contains(ev.relatedTarget)) { focused = false; sync(); } });
  /* swipe left or right on a touch screen */
  var sx = null, sy = 0;
  region.addEventListener("touchstart", function (ev) { sx = ev.touches[0].clientX; sy = ev.touches[0].clientY; }, { passive: true });
  region.addEventListener("touchend", function (ev) {
    if (sx === null) return;
    var dx = ev.changedTouches[0].clientX - sx, dy = ev.changedTouches[0].clientY - sy; sx = null;
    if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5) manual(cur + (dx < 0 ? 1 : -1));
  }, { passive: true });
  document.addEventListener("visibilitychange", sync);
  go(0); sync();

  /* Latest sermon: the page shows a poster, and the YouTube player loads only when someone presses play.
     YouTube refuses to play inside a file opened straight from a computer (file://), so there, and in
     the Claude preview, pressing play opens the video on YouTube instead. */
  var poster = $("#sermon-poster"), vid = (poster.getAttribute("href").match(/(?:v=|youtu\.be\/|embed\/|live\/|shorts\/)([\w-]{11})/) || [])[1];
  if (vid && EMBEDS && location.protocol !== "file:") {
    $(".host", poster).textContent = "Play video";
    poster.removeAttribute("target");
    poster.addEventListener("click", function (ev) {
      ev.preventDefault();
      var f = document.createElement("iframe");
      f.src = "https://www.youtube-nocookie.com/embed/" + vid + "?autoplay=1&rel=0";
      f.title = "Latest sermon video"; f.referrerPolicy = "strict-origin-when-cross-origin";
      f.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"; f.allowFullscreen = true;
      var box = $("#sermon-video"); while (box.firstChild) box.removeChild(box.firstChild); box.appendChild(f); f.focus();
    });
  }

  /* Footer map: shows where the church meets this Sunday. People can drag and zoom it; the label opens Google Maps. */
  var spot = null;
  (SITE.meetingPlaces || []).forEach(function (m) { if (!spot && (!m.until || day(m.until) >= today)) spot = m; });
  if (spot) {
    var full = spot.name + ", " + spot.address, q = encodeURIComponent(full);
    $("#map-place").textContent = full; $("#map-when").textContent = spot.when;
    $("#map-link").href = "https://www.google.com/maps/search/?api=1&query=" + q;
    $("#map-h").textContent = spot.until ? "Where we meet this Sunday" : "Where we meet";
    /* first-time visitors: this Sunday's time and place under the hero, and directions straight to it */
    $("#sun-label").textContent = spot.until ? "This Sunday" : "Every Sunday";
    $("#sun-time").textContent = spot.time;
    $("#sun-place").textContent = spot.name + ". See all service times";
    $$("[data-dir]").forEach(function (a) {
      a.href = "https://www.google.com/maps/dir/?api=1&destination=" + q; a.target = "_blank"; a.rel = "noopener";
      var note = document.createElement("span"); note.className = "sr-only"; note.textContent = " to " + spot.name + " (opens in a new tab)";
      a.appendChild(note);
    });
    if (EMBEDS) {
      var mf = document.createElement("iframe");
      mf.src = spot.embed || ("https://www.google.com/maps?q=" + q + "&z=15&output=embed");
      mf.title = "Google Map showing " + full; mf.loading = "lazy"; mf.referrerPolicy = "strict-origin-when-cross-origin"; mf.allowFullscreen = true;
      $("#map").prepend(mf); $("#map").classList.add("live");
    }
  }

  /* Mobile menu */
  var toggle = $("#nav-toggle"), nav = $("#site-nav"), toggleText = $("#nav-toggle-text");
  function setMenu(open) {
    nav.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggleText.textContent = open ? "Close" : "Menu";
  }
  toggle.addEventListener("click", function () { setMenu(!nav.classList.contains("open")); });
  nav.addEventListener("click", function (ev) { if (ev.target.closest("a")) setMenu(false); });
  document.addEventListener("keydown", function (ev) {
    if (ev.key === "Escape" && nav.classList.contains("open")) { setMenu(false); toggle.focus(); }
  });

  /* Accordions: every panel is open without JavaScript; here we collapse all but the first */
  $$(".acc-btn").forEach(function (btn) {
    var panel = document.getElementById(btn.getAttribute("aria-controls"));
    var open = btn.hasAttribute("data-open");
    btn.setAttribute("aria-expanded", String(open)); panel.hidden = !open;
    btn.addEventListener("click", function () {
      var now = btn.getAttribute("aria-expanded") !== "true";
      btn.setAttribute("aria-expanded", String(now)); panel.hidden = !now;
    });
  });

  function openBelief() { var bb = $("#acc-b2"); if (bb.getAttribute("aria-expanded") !== "true") bb.click(); }
  $$("a[href='#believe']").forEach(function (a) { a.addEventListener("click", openBelief); });
  if (location.hash === "#believe") openBelief();

  /* Gallery lightbox */
  var box = $("#lightbox"), tiles = $$("#gallery-grid .tile"), at = 0;
  function show(i) {
    at = (i + tiles.length) % tiles.length;
    var img = $("img", tiles[at]);
    $("#lb-img").src = img.src; $("#lb-img").alt = img.alt;
    $("#lb-cap").textContent = tiles[at].dataset.cap;
  }
  if (box.showModal) {
    tiles.forEach(function (t, i) { t.addEventListener("click", function () { show(i); box.showModal(); }); });
    $("#lb-close").addEventListener("click", function () { box.close(); });
    $("#lb-prev").addEventListener("click", function () { show(at - 1); });
    $("#lb-next").addEventListener("click", function () { show(at + 1); });
    box.addEventListener("click", function (ev) { if (ev.target === box) box.close(); });
    box.addEventListener("keydown", function (ev) {
      if (ev.key === "ArrowLeft") show(at - 1);
      if (ev.key === "ArrowRight") show(at + 1);
    });
    box.addEventListener("close", function () { tiles[at].focus(); });
  }

  /* Mark the section in view in the nav */
  if ("IntersectionObserver" in window) {
    var links = {};
    $$(".site-nav a[href^='#']").forEach(function (a) { links[a.getAttribute("href").slice(1)] = a; });
    var spy = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        var a = links[en.target.id];
        if (!a) return;
        if (en.isIntersecting) { $$(".site-nav a[aria-current]").forEach(function (x) { x.removeAttribute("aria-current"); }); a.setAttribute("aria-current", "location"); }
      });
    }, { rootMargin: "-45% 0px -50% 0px" });
    ["about", "serve", "upcoming", "visit"].forEach(function (id) { spy.observe(document.getElementById(id)); });
  }
})();
</script>
</body>
</html>
