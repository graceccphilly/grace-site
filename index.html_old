<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:ital,wght@0,400;0,600;0,700;1,400&family=Archivo+Black&family=Permanent+Marker&family=Source+Serif+4:ital,wght@1,400;1,500&display=swap">
<style>
/* Layout: flyer logic at page scale. Cream sheets carry the reading, black bands carry
   times and places, one tilted yellow block per screen carries the emphasis. */
:root {
  color-scheme: only light; /* always the cream look, even on devices set to dark mode */
  --paper: #fbf6ec;
  --paper-2: #efe4d0;
  --card: #fffaf2;
  --ink: #121110;
  --ink-soft: #46413b;
  --edge: #121110;
  --line: #d9cdb6;
  --sun: #ffc324;
  --on-sun: #121110;
  --band: #121110;
  --band-2: #1e1c19;
  --on-band: #fbf6ec;
  --on-band-soft: #d8d0c0;
  --ring: #121110;

  --display: "Archivo Black", "Arial Black", Impact, sans-serif;
  --tall: "Anton", "Arial Narrow", Impact, sans-serif;
  --body: "Archivo", "Helvetica Neue", Arial, sans-serif;
  --marker: "Permanent Marker", "Comic Sans MS", cursive;
  --serif: "Source Serif 4", Georgia, "Times New Roman", serif;

  --gutter: clamp(16px, 4vw, 40px);
  --header-h: 76px;
  --emblem: url("data:image/svg+xml;base64,");
  --wordmark: url("data:image/svg+xml;base64,");
  --lockup: url("data:image/svg+xml;base64,");
}
*, *::before, *::after { box-sizing: border-box; }
[hidden] { display: none !important; }
html:not(.js) [data-from] { display: none !important; }
html { scroll-padding-top: calc(var(--header-h) + 16px); }
@media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
body {
  margin: 0; background: var(--paper); color: var(--ink);
  font-family: var(--body); font-size: 1.0625rem; line-height: 1.6;
  overflow-x: hidden; overflow-x: clip;
}
h1, h2, h3, h4, p, ul, ol, dl, dd, figure { margin: 0; }
ul, ol { padding: 0; list-style: none; }
img { display: block; max-width: 100%; height: auto; }
a { color: inherit; text-decoration-thickness: 2px; text-underline-offset: 3px; text-decoration-color: var(--sun); }
a:hover { text-decoration-color: currentColor; }
:focus-visible { outline: 3px solid var(--ring); outline-offset: 3px; }
button { font: inherit; color: inherit; }

/* Page background photo: fixed to the screen, so it stays put while the page scrolls.
   A cream layer at 85% sits over it. Set the image in SITE.pageImage. */
.has-page-bg body::before, .has-page-bg body::after { content: ""; position: fixed; left: 0; top: 0; width: 100%; height: 100vh; height: 100lvh; z-index: -1; pointer-events: none; }
.has-page-bg body::before { background: var(--page-image) center / cover no-repeat; }
@media (max-width: 700px) { .has-page-bg body::before { background-image: var(--page-image-small, var(--page-image)); } }
.has-page-bg body::after { background: var(--paper); opacity: .85; }
.has-page-bg .hero { background: transparent; }
.has-page-bg .section.tint { background: linear-gradient(rgba(239, 228, 208, .6), rgba(239, 228, 208, 0)); }

.wrap { max-width: 1180px; margin-inline: auto; padding-inline: var(--gutter); }
.band { background: var(--band); color: var(--on-band); --ring: var(--sun); }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

.skip {
  position: absolute; left: var(--gutter); top: -100px; z-index: 100;
  background: var(--sun); color: var(--on-sun); padding: 10px 16px; font-weight: 700;
}
.skip:focus { top: calc(env(safe-area-inset-top, 0px) + 8px); }

.label {
  font-size: .8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em;
}
.emblem, .lockup { display: block; background: currentColor; }
.emblem { aspect-ratio: 924 / 1026; -webkit-mask: var(--emblem) center / contain no-repeat; mask: var(--emblem) center / contain no-repeat; }
.lockup { aspect-ratio: 2587 / 1479; -webkit-mask: var(--lockup) center / contain no-repeat; mask: var(--lockup) center / contain no-repeat; }

/* Browsers without aspect-ratio (Safari 14 and older) */
@supports not (aspect-ratio: 1 / 1) {
  .brand .emblem { height: 49px; } .wordmark { width: 224px; } .hero-emblem { height: 333px; }
  .foot-brand .lockup { height: 149px; } .video { height: 0; padding-top: 56.25%; } .photo-slot { min-height: 340px; }
}

/* Buttons */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  min-height: 48px; padding: 10px 22px;
  background: var(--sun); color: var(--on-sun); border: 3px solid var(--on-sun);
  font-weight: 700; font-size: .9375rem; text-transform: uppercase; letter-spacing: .06em;
  text-decoration: none; cursor: pointer; text-align: center;
  box-shadow: 4px 4px 0 var(--ink);
}
.btn:hover { box-shadow: 6px 6px 0 var(--ink); transform: translate(-2px, -2px); }
.btn.quiet { background: transparent; color: var(--ink); border-color: var(--ink); box-shadow: none; }
.btn.quiet:hover { background: var(--ink); color: var(--paper); transform: none; }
.band .btn { border-color: var(--sun); box-shadow: none; }
.band .btn:hover { background: var(--on-band); border-color: var(--on-band); transform: none; }
.band .btn.quiet { color: var(--on-band); border-color: var(--on-band); background: transparent; }
.band .btn.quiet:hover { background: var(--on-band); color: var(--band); }
@media (prefers-reduced-motion: no-preference) { .btn { transition: transform .12s, box-shadow .12s, background .12s; } }

/* Gaps the church still needs to fill in */
.todo {
  border: 2px dashed currentColor; padding: 14px 16px; display: grid; gap: 4px;
  font-size: .9375rem; line-height: 1.45;
}
.todo b { font-family: var(--marker); font-weight: 400; font-size: 1rem; letter-spacing: .04em; text-transform: uppercase; }
.todo.inline { display: inline-block; padding: 2px 10px; font-size: .875rem; }

/* Social icons */
.social { display: flex; gap: 8px; }
.social a { width: 40px; height: 40px; display: grid; place-items: center; background: var(--ink); color: var(--paper); border: 2px solid var(--ink); }
.band .social a { background: var(--on-band); color: var(--band); border-color: var(--on-band); }
.social a:hover, .band .social a:hover { background: var(--sun); color: var(--on-sun); border-color: var(--sun); }
.social svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.site-nav .soc-li { margin-left: 8px; }

/* Header */
.site-header {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50;
  background: var(--paper); border-bottom: 3px solid var(--ink);
}
.site-header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: var(--header-h); }
.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; min-width: 0; }
.brand .emblem { width: 44px; flex: none; }
.wordmark { display: block; height: 30px; aspect-ratio: 2587 / 347; flex: none; background: currentColor; -webkit-mask: var(--wordmark) center / contain no-repeat; mask: var(--wordmark) center / contain no-repeat; }
.nav-toggle {
  display: none; align-items: center; gap: 10px; min-height: 44px; padding: 6px 14px;
  background: var(--ink); color: var(--paper); border: 0; cursor: pointer;
  font-weight: 700; font-size: .875rem; text-transform: uppercase; letter-spacing: .1em;
}
.nav-toggle .bars { width: 20px; height: 14px; border-block: 2px solid currentColor; position: relative; }
.nav-toggle .bars::after { content: ""; position: absolute; inset: 4px 0 auto; border-top: 2px solid currentColor; }
.site-nav ul { display: flex; align-items: center; gap: 4px; }
.site-nav .m-only { display: none; }
.site-nav li > a {
  display: block; padding: 10px 9px; white-space: nowrap; text-decoration: none;
  font-weight: 700; font-size: .875rem; text-transform: uppercase; letter-spacing: .08em;
}
.site-nav li > a:not(.btn):hover, .site-nav li > a[aria-current] { box-shadow: inset 0 -4px 0 var(--sun); }
.site-nav .btn { min-height: 40px; padding: 6px 16px; margin-left: 8px; box-shadow: none; }
.site-nav .btn:hover { transform: none; box-shadow: none; background: var(--ink); color: var(--paper); border-color: var(--ink); }
@media (max-width: 1200px) {
  .js .nav-toggle { display: inline-flex; }
  .site-nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 3px solid var(--ink); padding: 8px var(--gutter) 20px; }
  .site-nav ul { flex-direction: column; align-items: stretch; gap: 0; }
  .site-nav .m-only { display: block; }
  .site-nav li + li { border-top: 1px solid var(--line); }
  .site-nav li > a { padding: 14px 4px; font-size: 1rem; }
  .site-nav .soc-li { padding-block: 14px 4px; }
  .site-nav .social a { width: 48px; height: 48px; }
  .site-nav .give-li { border-top: 0; padding-top: 12px; }
  .site-nav .btn { margin-left: 0; min-height: 48px; }
  .js .site-nav:not(.open) { display: none; }
  html:not(.js) .site-header { position: static; }
  html:not(.js) .site-nav { position: static; border: 0; padding: 0 0 12px; flex-basis: 100%; }
  html:not(.js) .site-header .wrap { flex-wrap: wrap; }
}
@media (max-width: 480px) { .wordmark { height: 24px; } .brand { gap: 8px; } .brand .emblem { width: 36px; } }
@media (max-width: 380px) { .wordmark { height: 20px; } .brand .emblem { width: 32px; } }

/* Hero carousel: slides share one grid cell so the hero never changes height */
.hero { background: linear-gradient(var(--paper), var(--paper-2)); overflow-x: hidden; overflow-x: clip; }
.hero { --hero-overlay: var(--paper); }
.hero.dark .hero-stage { --hero-overlay: var(--band); --paper: var(--band); --ink: var(--on-band); --ink-soft: var(--on-band-soft); --ring: var(--sun); color: var(--ink); }
.hero.dark .hero-stage .btn { box-shadow: none; border-color: var(--sun); }
.hero.dark .hero-stage .btn.quiet { border-color: var(--ink); }
.hero.dark .ticket { outline: 2px solid var(--sun); }
.hero-stage { position: relative; }
.hero-bgs { position: absolute; inset: 0; overflow: hidden; }
.hero-bg { position: absolute; inset: 0; background: center / cover no-repeat; opacity: 0; }
.hero-bg.is-active { opacity: 1; }
.hero-bg.has-img::after { content: ""; position: absolute; inset: 0; background: var(--hero-overlay); opacity: .85; }
@media (prefers-reduced-motion: no-preference) { .hero-bg { transition: opacity .6s ease; } }
.hero-inner { position: relative; padding-block: clamp(36px, 6vw, 72px) clamp(20px, 3vw, 32px); }
.slides { display: grid; }
.slide {
  grid-area: 1 / 1; min-width: 0;
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 340px); gap: clamp(28px, 5vw, 56px); align-items: center;
}
.js .slide:not(.is-active) { visibility: hidden; opacity: 0; }
@media (prefers-reduced-motion: no-preference) {
  .js .slide { transition: opacity .5s ease, visibility 0s linear .5s; }
  .js .slide.is-active { transition: opacity .5s ease; }
}
html:not(.js) .slide { grid-area: auto; }
html:not(.js) .slides { gap: 56px; }
.hero-copy { container-type: inline-size; min-width: 0; }
.hero-h { display: grid; gap: 18px; }
.h1-name { font-family: var(--body); font-size: .875rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-soft); }
.h1-motto { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: clamp(1.75rem, 5.2vw, 4.25rem); line-height: 1; white-space: nowrap; letter-spacing: -.02em; display: grid; justify-items: start; gap: .06em; }
.h1-motto .hl { background: var(--sun); color: var(--on-sun); padding: .04em .22em .08em; margin-left: -.12em; transform: rotate(-2deg); transform-origin: left center; }
@media (max-width: 860px) { .h1-motto { font-size: clamp(1.5rem, 8.4vw, 3.25rem); } }
@supports (width: 1cqi) { .h1-motto { font-size: clamp(1.5rem, 9.6cqi, 5rem); } }
.lede { font-size: clamp(1.0625rem, 1.6vw, 1.25rem); max-width: 34em; margin-top: 30px; color: var(--ink-soft); }
.actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 28px; }
.zoom-id { display: flex; flex-wrap: wrap; gap: 4px 22px; margin-top: 14px; font-size: .9375rem; font-weight: 600; }
.zoom-id b { font-family: var(--tall); font-weight: 400; font-size: 1.25rem; letter-spacing: .03em; margin-left: 4px; user-select: all; }
.hero-emblem { width: min(300px, 100%); justify-self: end; }
.hero-ctl { display: flex; align-items: center; gap: 6px; margin-top: clamp(24px, 4vw, 44px); flex-wrap: wrap; }
html:not(.js) .hero-ctl { display: none; }
.hero-ctl button { min-width: 44px; height: 44px; display: grid; place-items: center; background: transparent; border: 2px solid var(--ink); cursor: pointer; padding: 0; }
.hero-ctl button:hover { background: var(--ink); color: var(--paper); }
.hero-ctl svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
.hero-ctl .dots { display: flex; margin-inline: 6px; }
.hero-ctl .dots button { border: 0; min-width: 36px; }
.hero-ctl .dots button:hover { background: transparent; }
.hero-ctl .dots button::before { content: ""; width: 14px; height: 14px; border: 2px solid var(--ink); }
.hero-ctl .dots button:hover::before { background: var(--ink); }
.hero-ctl .dots button[aria-current="true"]::before { width: 30px; background: var(--sun); }

.ticket {
  background: var(--band); color: var(--on-band); --ring: var(--sun);
  padding: 28px 26px 30px; display: grid; gap: 10px; justify-items: start;
  transform: rotate(2deg); box-shadow: 12px 12px 0 var(--sun);
  max-width: 380px; justify-self: end; width: 100%;
}
.ticket .tag { font-family: var(--marker); background: var(--sun); color: var(--on-sun); padding: 2px 14px; font-size: 1.25rem; transform: rotate(-3deg); margin-bottom: 6px; }
.ticket .when { font-family: var(--tall); font-size: clamp(4rem, 9vw, 5.5rem); line-height: 1; color: var(--sun); text-transform: uppercase; letter-spacing: .01em; }
.ticket .time { font-family: var(--tall); font-size: 1.75rem; line-height: 1.1; text-transform: uppercase; letter-spacing: .02em; margin-bottom: 6px; }
.ticket .what { font-family: var(--display); font-size: 1.375rem; line-height: 1.15; text-transform: uppercase; }
.ticket p.where { color: var(--on-band-soft); font-size: 1rem; }
.ticket a { font-weight: 700; margin-top: 6px; }

.strip .wrap { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding-block: 26px; }
.strip .cell { padding-inline: clamp(12px, 3vw, 36px); display: grid; gap: 2px; align-content: center; }
.strip .cell + .cell { border-left: 3px solid var(--sun); }
.strip .cell:first-child { padding-left: 0; }
.strip .label { color: var(--sun); }
.strip .big { font-family: var(--tall); font-size: clamp(2rem, 4.4vw, 3rem); line-height: 1.05; text-transform: uppercase; }
.strip .small { color: var(--on-band-soft); font-size: .9375rem; }
.strip a.cell { text-decoration: none; }
.strip a.cell:hover .big { color: var(--sun); }
.strip a.cell .small { text-decoration: underline; text-decoration-color: var(--sun); text-underline-offset: 3px; }
.strip .acts { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; align-content: center; }
.strip .acts .btn { min-height: 46px; padding: 8px 18px; }
@media (max-width: 860px) {
  .slide { grid-template-columns: minmax(0, 1fr); align-items: start; gap: 22px; }
  .hero-emblem { display: none; }
  .hero-inner { padding-block: 28px 18px; }
  .hero-h { gap: 12px; }
  .lede { margin-top: 18px; font-size: 1rem; line-height: 1.5; }
  .actions { margin-top: 18px; gap: 10px; }
  .hero-ctl { margin-top: 20px; }
  /* the date card becomes a one-line tag */
  .ticket { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding: 10px 14px; transform: none; box-shadow: 5px 5px 0 var(--sun); width: auto; max-width: 100%; justify-self: start; }
  .ticket .tag { font-size: 1rem; padding: 0 10px; margin: 0; transform: rotate(-2deg); }
  .ticket .when { font-size: 2rem; }
  .ticket .time { font-size: 1.25rem; margin: 0; }
  .ticket .what, .ticket .where { display: none; }
  .zoom-id { margin-top: 10px; font-size: .875rem; gap: 2px 16px; }
  .zoom-id b { font-size: 1.0625rem; }
  .strip .wrap { grid-template-columns: repeat(2, minmax(0, 1fr)); padding-block: 16px; }
  .strip .cell { padding-inline: 14px; }
  .strip .cell:first-child { padding-left: 0; }
  .strip .big { font-size: 1.75rem; }
  .strip .small { font-size: .8125rem; line-height: 1.35; }
  .strip .label { font-size: .6875rem; letter-spacing: .1em; }
  .strip .acts { grid-column: 1 / -1; padding: 14px 0 0; margin-top: 14px; border-left: 0; border-top: 3px solid var(--sun); }
  .strip .acts .btn { flex: 1 1 140px; font-size: .8125rem; letter-spacing: .04em; padding: 8px 8px; white-space: nowrap; }
}

/* Sections */
.section { padding-block: clamp(56px, 8vw, 104px); }
.section.tint { background: linear-gradient(var(--paper-2), var(--paper)); }
.band.section { border-top: 8px solid var(--sun); }
.section-head { display: grid; gap: 12px; margin-bottom: clamp(28px, 4vw, 48px); max-width: 46rem; }
.section-head h2 { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: clamp(2rem, 5.4vw, 3.5rem); line-height: 1; letter-spacing: -.015em; text-wrap: balance; }
.section-head p { color: var(--ink-soft); font-size: 1.125rem; }
.band .section-head p { color: var(--on-band-soft); }

/* Latest sermon */
.sermon { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
.video { aspect-ratio: 16 / 9; max-width: 100%; background: var(--band); border: 3px solid var(--edge); box-shadow: 10px 10px 0 var(--sun); position: relative; }
.video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.video-poster { position: absolute; inset: 0; display: block; }
.video-poster img { width: 100%; height: 100%; object-fit: cover; }
.video-poster .play { position: absolute; left: 50%; top: 50%; width: 84px; height: 84px; margin: -42px 0 0 -42px; background: var(--sun); border: 3px solid var(--on-sun); display: grid; place-items: center; box-shadow: 6px 6px 0 var(--on-sun); }
.video-poster:hover .play { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--on-sun); }
.video-poster .play svg { width: 40px; height: 40px; fill: var(--on-sun); }
.video-poster .host { position: absolute; left: 0; top: 0; background: var(--band); color: var(--on-band); padding: 6px 12px; font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.sermon-copy { display: grid; gap: 14px; justify-items: start; }
.sermon-copy .label { color: var(--ink-soft); }
.sermon-copy h2 { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: clamp(1.75rem, 3.6vw, 2.75rem); line-height: 1.02; letter-spacing: -.015em; text-wrap: balance; }
.sermon-copy .ref { font-family: var(--tall); font-size: 1.375rem; text-transform: uppercase; letter-spacing: .02em; }
.sermon-copy p:not(.label):not(.ref) { color: var(--ink-soft); max-width: 40ch; }
.sermon-copy .actions { margin-top: 10px; }
@media (max-width: 860px) { .sermon { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 480px) { .video { box-shadow: 6px 6px 0 var(--sun); } }

/* Upcoming service cards */
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 30px; }
.svc { background: var(--card); border: 3px solid var(--edge); box-shadow: 10px 10px 0 var(--sun); display: flex; flex-direction: column; min-width: 0; }
.svc .date { background: var(--band); color: var(--sun); font-family: var(--tall); font-size: clamp(1.75rem, 3.4vw, 2.375rem); line-height: 1.1; text-transform: uppercase; text-align: center; padding: 14px 12px; letter-spacing: .01em; }
.svc .body { padding: 22px 24px 26px; display: grid; gap: 10px; align-content: start; flex: 1; }
.svc h3 { font-family: var(--display); font-weight: 400; font-size: 1.25rem; line-height: 1.2; text-transform: uppercase; letter-spacing: .01em; }
.svc p { color: var(--ink-soft); }
.svc h3 + p { color: var(--ink); font-weight: 700; }
.svc address { font-style: normal; color: var(--ink-soft); }
.svc .go { font-weight: 700; margin-top: 4px; }
@media (max-width: 480px) { .cards { gap: 26px; } .svc { box-shadow: 6px 6px 0 var(--sun); } }

/* About accordions */
.acc { border: 3px solid var(--edge); background: var(--card); }
.acc + .acc { margin-top: 14px; }
.acc h3 { font: inherit; }
.acc-btn {
  display: flex; align-items: center; gap: 16px; width: 100%; text-align: left;
  padding: 18px 22px; background: transparent; border: 0; cursor: pointer;
  font-family: var(--display); font-size: clamp(1.0625rem, 2.2vw, 1.3125rem); text-transform: uppercase; letter-spacing: .01em;
}
html:not(.js) .acc-btn { cursor: default; }
.acc-btn .pm { flex: none; width: 32px; height: 32px; background: var(--sun); position: relative; }
.acc-btn .pm::before, .acc-btn .pm::after { content: ""; position: absolute; left: 8px; right: 8px; top: 14.5px; height: 3px; background: var(--on-sun); }
.acc-btn .pm::after { transform: rotate(90deg); }
.acc-btn[aria-expanded="true"] .pm::after, html:not(.js) .acc-btn .pm::after { transform: none; }
.acc-btn[aria-expanded="true"] { background: var(--band); color: var(--on-band); --ring: var(--sun); outline-offset: -6px; }
.acc-panel { padding: 26px 22px 30px; display: grid; gap: 18px; border-top: 3px solid var(--edge); }
.acc-panel > p { max-width: 65ch; }
.acc-panel > p.src { font-family: var(--serif); font-style: italic; color: var(--ink-soft); }
.values { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); background: var(--band); color: var(--on-band); }
.values li { padding: 20px 16px; text-align: center; display: grid; gap: 2px; }
.values li + li { border-left: 3px solid var(--sun); }
.values .label { color: var(--sun); }
.values strong { font-family: var(--tall); font-weight: 400; font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.05; text-transform: uppercase; }
@media (max-width: 560px) { .values { grid-template-columns: minmax(0, 1fr); } .values li + li { border-left: 0; border-top: 3px solid var(--sun); } }
.creed { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.creed li { background: var(--band); color: var(--on-band); border-left: 8px solid var(--sun); padding: 18px 22px 20px; display: grid; gap: 6px; align-content: start; }
.creed h4 { font-family: var(--display); font-weight: 400; font-size: 1.125rem; text-transform: uppercase; letter-spacing: .02em; }
.creed q { font-family: var(--serif); font-style: italic; font-size: 1.125rem; line-height: 1.4; color: var(--sun); }
@media (max-width: 640px) { .creed { grid-template-columns: minmax(0, 1fr); } }
.pastor { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 300px); gap: 36px; align-items: start; }
.pastor .col { display: grid; gap: 14px; }
.photo-slot { aspect-ratio: 4 / 5; max-width: 100%; border: 3px solid var(--edge); box-shadow: 8px 8px 0 var(--sun); overflow: hidden; background: var(--paper-2); }
.letter p { max-width: 62ch; }
.letter blockquote { margin: 4px 0; padding: 14px 20px; border-left: 8px solid var(--sun); background: var(--band); color: var(--sun); font-family: var(--serif); font-style: italic; font-size: 1.125rem; line-height: 1.45; }
.letter cite { font-style: normal; font-family: var(--body); font-size: .875rem; color: var(--on-band-soft); white-space: nowrap; }
.letter .sign { font-family: var(--serif); font-style: italic; margin-top: 6px; }
.letter .sign strong { font-family: var(--display); font-style: normal; font-weight: 400; text-transform: uppercase; letter-spacing: .01em; }
.photo-slot img { width: 100%; height: 100%; object-fit: cover; }
@media (max-width: 700px) { .pastor { grid-template-columns: minmax(0, 1fr); } .photo-slot { max-width: 280px; order: -1; } }

/* Ministries */
#serve-empty { color: var(--on-band-soft); }
.min-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
.min { background: var(--band-2); padding: 28px 26px 30px; display: grid; gap: 14px; align-content: start; min-width: 0; border-top: 4px solid var(--sun); }
.min.wide { grid-column: 1 / -1; }
.min-top { display: flex; align-items: center; gap: 16px; }
.min svg { width: 44px; height: 44px; flex: none; fill: none; stroke: var(--sun); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
.min h3 { font-family: var(--display); font-weight: 400; font-size: clamp(1.25rem, 2.6vw, 1.625rem); line-height: 1.1; text-transform: uppercase; }
.min .when { font-family: var(--tall); font-size: 1.75rem; line-height: 1.1; color: var(--sun); text-transform: uppercase; letter-spacing: .01em; }
.min p { color: var(--on-band-soft); max-width: 60ch; }
.min p strong { color: var(--on-band); }
.min .actions { margin-top: 6px; }
.food { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px 40px; margin-top: 6px; }
.food h4 { font-size: .8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: var(--sun); margin-bottom: 12px; }
.items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.items li { background: var(--band); border-left: 6px solid var(--sun); padding: 10px 14px; font-weight: 700; }
.drops { display: grid; gap: 16px; }
.drops li { display: grid; gap: 2px; }
.drops strong { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: 1rem; }
.drops address { font-style: normal; color: var(--on-band-soft); }
@media (max-width: 760px) { .min-grid, .food { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 400px) { .items { grid-template-columns: minmax(0, 1fr); } }

/* Gallery */
.gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 3.5vw, 40px); }
@media (max-width: 520px) { .gallery { grid-template-columns: minmax(0, 1fr); } }
.gallery.single { grid-template-columns: minmax(0, 520px); }
.tile { display: block; width: 100%; padding: 0; margin: 0; border: 3px solid var(--edge); background: var(--card); cursor: zoom-in; aspect-ratio: 1 / 1; max-width: 100%; overflow: hidden; }
.tile img { width: 100%; height: 100%; object-fit: cover; }
.tile:hover, .tile:focus-visible { box-shadow: 8px 8px 0 var(--sun); }
html:not(.js) .tile { cursor: default; }
dialog.lightbox { border: 0; padding: 0; background: var(--band); color: var(--on-band); --ring: var(--sun); max-width: min(94vw, 1040px); max-height: 94vh; overflow: auto; }
dialog.lightbox::backdrop { background: rgba(8, 8, 7, .86); }
.lb-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 10px 10px 18px; position: sticky; top: 0; background: var(--band); }
.lb-bar p { font-weight: 700; font-size: .9375rem; min-width: 0; }
.lb-btns { display: flex; gap: 8px; flex: none; }
.lb-btns button { min-width: 44px; min-height: 44px; padding: 0 14px; background: var(--sun); color: var(--on-sun); border: 0; cursor: pointer; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; font-size: .8125rem; }
.lightbox img { width: 100%; max-height: calc(94vh - 70px); object-fit: contain; }

/* Visit */
.visit { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
.times { background: var(--card); border: 3px solid var(--edge); box-shadow: 10px 10px 0 var(--sun); }
.times h3 { background: var(--band); color: var(--sun); font-family: var(--tall); font-weight: 400; font-size: 2rem; text-transform: uppercase; padding: 12px 24px; letter-spacing: .01em; }
.times dl { padding: 8px 24px 18px; }
.times .row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; align-items: baseline; padding-block: 16px; }
.times .row + .row { border-top: 1px solid var(--line); }
.times dt { font-weight: 700; }
.times dd.t { font-family: var(--tall); font-size: 1.75rem; line-height: 1; font-variant-numeric: tabular-nums; }
.times dd.w { grid-column: 1 / -1; color: var(--ink-soft); font-size: .9375rem; }
.faq { display: grid; gap: 26px; }
.faq h3 { font-family: var(--display); font-weight: 400; font-size: 1.1875rem; text-transform: uppercase; margin-bottom: 6px; }
.faq p { color: var(--ink-soft); max-width: 60ch; }
.meet { display: grid; gap: 12px; color: var(--ink-soft); max-width: 60ch; }
.meet li { padding-left: 14px; border-left: 4px solid var(--sun); }
.meet b { display: block; color: var(--ink); }
.expect { margin-top: clamp(40px, 6vw, 72px); padding-top: clamp(28px, 4vw, 44px); border-top: 3px solid var(--edge); }
.expect h3 { font-family: var(--display); font-weight: 400; font-size: clamp(1.5rem, 3.4vw, 2.25rem); text-transform: uppercase; letter-spacing: -.01em; margin-bottom: 22px; }
.expect ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 40px; }
.expect li { padding-left: 16px; border-left: 4px solid var(--sun); color: var(--ink-soft); max-width: 58ch; }
.expect li b { display: block; font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: 1.0625rem; color: var(--ink); margin-bottom: 4px; }
@media (max-width: 720px) { .expect ul { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 820px) { .visit { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 480px) { .times { box-shadow: 6px 6px 0 var(--sun); } }

/* Footer */
.map-h { margin-top: 44px; }
.foot-map { position: relative; height: clamp(240px, 32vw, 340px); margin-top: 0; border: 3px solid var(--sun); background:
  linear-gradient(var(--band-2) 2px, transparent 2px) 0 0 / 100% 56px,
  linear-gradient(90deg, var(--band-2) 2px, transparent 2px) 0 0 / 72px 100%, var(--band); overflow: hidden; }
.foot-map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.map-link { position: absolute; inset: 0; display: grid; place-items: center; text-decoration: none; outline-offset: -8px; }
.map-card { display: flex; align-items: center; gap: 14px; background: var(--sun); color: var(--on-sun); padding: 12px 20px 12px 14px; border: 3px solid var(--on-sun); box-shadow: 6px 6px 0 var(--on-sun); max-width: calc(100% - 32px); }
.map-card svg { width: 34px; height: 34px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; }
.map-card > span { display: grid; line-height: 1.25; min-width: 0; }
.map-card b { font-family: var(--display); font-weight: 400; text-transform: uppercase; overflow-wrap: anywhere; }
.map-card i { font-style: normal; font-size: .8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; text-decoration: underline; text-underline-offset: 3px; }
.foot-map.live .map-link { inset: auto auto 14px 14px; display: block; max-width: calc(100% - 28px); outline-offset: 3px; }
.foot-map.live .map-card { max-width: 100%; }
.foot-map.live .map-card { padding: 8px 14px 8px 10px; box-shadow: 4px 4px 0 var(--on-sun); }
.foot-map.live .map-card svg { width: 26px; height: 26px; }
@media (max-width: 600px) {
  .foot-map { height: 320px; }
  .map-card { gap: 10px; padding: 8px 12px 8px 10px; }
  .map-card b { font-size: .8125rem; line-height: 1.25; }
  .map-card i { font-size: .6875rem; letter-spacing: .06em; line-height: 1.4; margin-top: 2px; }
  .foot-map.live .map-card svg { width: 22px; height: 22px; }
}
.site-footer { border-top: 8px solid var(--sun); padding-block: 56px 28px; }
.foot-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1fr); gap: 40px; }
.foot-brand { display: grid; gap: 18px; justify-items: start; align-content: start; }
.foot-brand .lockup { width: min(260px, 100%); }
.foot-brand p { font-family: var(--marker); font-size: 1.125rem; color: var(--sun); }
.site-footer h2 { font-size: .8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: var(--sun); margin-bottom: 14px; }
.contact { display: grid; gap: 14px; }
.contact dt { font-size: .8125rem; text-transform: uppercase; letter-spacing: .1em; color: var(--on-band-soft); }
.contact dd { font-weight: 600; overflow-wrap: anywhere; user-select: all; }
.foot-links { display: grid; gap: 2px; }
.foot-links a { font-weight: 600; display: inline-block; padding-block: 5px; }
.contact a, .foot-base a { display: inline-block; padding-block: 4px; }
.contact .note { font-weight: 400; font-size: .875rem; color: var(--on-band-soft); user-select: auto; margin-top: 4px; }
.foot-base { margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--band-2); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: .875rem; color: var(--on-band-soft); }
@media (max-width: 820px) { .foot-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
</style>
</head>
